# =============================================================================
# BillBuddy — server environment (AWS / Docker)
# Copy to .env and fill in. Never commit .env to git.
# =============================================================================

# REQUIRED — JWT signing (openssl rand -hex 32)
SECRET_KEY=change-me-to-a-long-random-string

# REQUIRED in production — public URL for invite links and emails
# Local:  http://localhost:8001
# AWS:    http://YOUR_IP  or  https://yourdomain.com
BASE_URL=http://localhost:8001

# REQUIRED for Docker/AWS — database password (docker-compose uses this)
POSTGRES_PASSWORD=change-me-strong-password

# -----------------------------------------------------------------------------
# Email — server sends invite emails and monthly PDF reports
# Without SMTP: use invite links manually; reports downloadable in app only
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# -----------------------------------------------------------------------------
# Receipt scanning — OPTIONAL server-wide fallback
# Each user can add their own API key in Settings (recommended).
# Only set these if you want a shared fallback when users have no key configured.
# -----------------------------------------------------------------------------
# SERVER_VLM_PROVIDER=google
# SERVER_VLM_MODEL=gemini-2.5-flash
# SERVER_VLM_API_KEY=

# JWT token lifetime (days)
ACCESS_TOKEN_EXPIRE_DAYS=7

# Local dev only — SQLite is used automatically when DATABASE_URL is unset
# Docker/AWS sets DATABASE_URL automatically via docker-compose.yml
